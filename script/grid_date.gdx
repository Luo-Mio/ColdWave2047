# ============================================================
# 文件：grid_date.gdx
# 说明：这是【参考学习文件】，不是 Godot 脚本，不会被引擎读取。
#       请把下面的内容完整抄进你自己的 grid_date.gd 里学习。
# ------------------------------------------------------------
# 用途：全局高度场数据（Autoload 单例）
#       用三维布尔数组记录"地图上每个格子(x,y)在每一层(z)
#       有没有砖块"，供角色/NPC/寻路等系统查询脚下楼层高度。
# ============================================================


# ------------------------------------------------------------
# extends Node
# 说明：继承 Node（最基础的节点类型）。
#       Autoload 单例必须是 Node（或其子类），它会常驻内存，
#       从游戏开始到结束都存在，任何脚本都能直接访问它。
# ------------------------------------------------------------
extends Node


# ------------------------------------------------------------
# 常量：FLOOR_HEIGHT = 8.0
# 说明：每层楼之间的"视觉高度差"。
#       你的等距瓷砖有 8 像素的视觉厚度，所以：
#       层1 比层0 高 8px (position.y = -8)
#       层2 比层0 高 16px (position.y = -16)
#       高一层 = 更靠屏幕上方 = Y 坐标更小 = 负方向偏移。
#       以后所有"楼层换算成像素"都用这个常量，改一处全改。
# ------------------------------------------------------------
const FLOOR_HEIGHT: float = 8.0


# ------------------------------------------------------------
# 变量：grid（高度场核心数组）
# 说明：用 Dictionary（字典/哈希表）模拟"稀疏三维布尔数组"。
#       key（键）是 Vector3i(x, y, z)：
#         x = 格子的横向编号
#         y = 格子的纵向编号
#         z = 楼层编号（0=地面，1=高一层的平台，2=再高一层...）
#       value（值）是 true/false（这个格子这层有没有砖）。
#
# 为什么用 Dictionary 而不是真正的三维数组？
#   1. Godot 没有原生"三维布尔数组"，嵌套数组写起来繁琐。
#   2. Dictionary 用 Vector3i 当键，查询是 O(1)（哈希查找），
#      和数组一样快。
#   3. 稀疏存储：地图上大部分格子是空的，Dictionary 只存"有砖"
#      的格子，空格子完全不占内存。大地图时省内存。
#
# 示例：
#   grid[Vector3i(10, 5, 0)] = true   ← 格(10,5)在地面层有砖
#   grid[Vector3i(10, 5, 1)] = true   ← 格(10,5)在第一层平台也有砖
#   说明格(10,5)从上往下有：第1层平台 + 地面，共两层。
# ------------------------------------------------------------
var grid: Dictionary = {}


# ------------------------------------------------------------
# 变量：layers
# 说明：保存所有 TileMapLayer 节点的引用（按楼层从低到高排序）。
#       layers[0] = 地面层(layer0)
#       layers[1] = 第一层平台(layer1)
#       layers[2] = 第二层平台(layer2)
#       ...
#       为什么要保存引用？因为查询"某格最高层"时需要知道
#       一共有几层、从高往低依次检查。
# ------------------------------------------------------------
var layers: Array[TileMapLayer] = []


# ------------------------------------------------------------
# 函数：build_from_layers(layer_nodes)
# 参数：layer_nodes —— 一个数组，存放所有 TileMapLayer 节点，
#                     顺序必须是"从低层到高层"。
# 作用：在地图加载时调用一次，把所有层的砖块信息读进 grid。
# 调用位置（放在你主场景的 _ready 里）：
#   GridData.build_from_layers([$layer0, $layer1, $layer2])
# ------------------------------------------------------------
func build_from_layers(layer_nodes: Array[TileMapLayer]) -> void:
	# 1. 保存层引用，供后续查询使用
	layers = layer_nodes

	# 2. 清空旧数据（防止重复构建时残留脏数据）
	grid.clear()

	# 3. 遍历每一层
	for z in layers.size():
		# get_used_cells() 返回这一层所有"有砖"的格子坐标数组
		var cells: Array[Vector2i] = layers[z].get_used_cells()

		# 4. 遍历这一层的每个有砖格子
		for cell in cells:
			# 用 Vector3i(x, y, z) 作为键，标记"这个位置这一层有砖"
			grid[Vector3i(cell.x, cell.y, z)] = true


# ------------------------------------------------------------
# 函数：get_highest_floor(cell) -> int
# 参数：cell —— 一个格子坐标 Vector2i(x, y)
# 返回：这个格子在 z 方向上"最高"的有砖楼层编号（int）
#       如果没有任何砖，返回 0（最低的地面层）。
#
# 作用：这是最重要的查询函数！
#       角色走到某个格子上时，用这个函数知道自己站在第几层，
#       然后据此调整自己的渲染位置和排序。
#
# 逻辑：从"最高层"往"最低层"逐层检查，
#       第一个发现"有砖"的层就是答案（因为越往上编号越大）。
# ------------------------------------------------------------
func get_highest_floor(cell: Vector2i) -> int:
	# 从最高层开始，往下逐层检查
	# layers.size() - 1 是最高层的索引，-1 是最后一层（最低层前一个）
	for z in range(layers.size() - 1, -1, -1):
		# 检查格子 (cell.x, cell.y) 在第 z 层有没有砖
		if grid.has(Vector3i(cell.x, cell.y, z)):
			return z  # 找到了，这就是最高的楼层
	# 全都没砖 → 返回 0（地面层）
	return 0


# ------------------------------------------------------------
# 函数：has_tile_at(cell, z) -> bool
# 参数：cell —— 格子坐标 Vector2i(x, y)
#       z    —— 楼层编号
# 返回：true（该格该层有砖）/ false（没有）
#
# 作用：通用查询。除了查"最高层"，有时你想知道"第2层具体
#       有没有砖"（比如判断头顶是否有遮挡、能否放置物体）。
# ------------------------------------------------------------
func has_tile_at(cell: Vector2i, z: int) -> bool:
	return grid.has(Vector3i(cell.x, cell.y, z))


# ------------------------------------------------------------
# 函数：set_tile(cell, z, exists)
# 参数：cell   —— 格子坐标 Vector2i(x, y)
#       z      —— 楼层编号
#       exists —— true=放置砖块，false=移除砖块
#
# 作用：运行时修改高度场。生存游戏里玩家"挖地/建墙/搭平台"
#       时，除了改 TileMapLayer 的显示，还要同步更新 grid，
#       这样查询结果才不会和画面脱节。
#
# 注意：这个函数只改数据，不改 TileMapLayer 的显示。
#       完整修改 = 改显示(用 layers[z].set_cell) + 改数据(本函数)。
# ------------------------------------------------------------
func set_tile(cell: Vector2i, z: int, exists: bool) -> void:
	var key := Vector3i(cell.x, cell.y, z)  # 拼出三维键
	if exists:
		grid[key] = true   # 放置 → 标记为有砖
	else:
		grid.erase(key)    # 移除 → 从字典删掉这个键


# ------------------------------------------------------------
# 函数：world_to_cell(layer_ref, world_pos) -> Vector2i
# 参数：layer_ref —— 任意一个 TileMapLayer 的引用（用于坐标换算）
#       world_pos —— 世界坐标 Vector2
# 返回：该世界坐标所在的格子坐标 Vector2i(x, y)
#
# 作用：角色在世界里移动时，位置是"世界坐标"(px)，
#       但 heightfield 数组的键是"格子坐标"(格)。
#       这个函数把两者打通。
#
# 用法示例（在角色脚本里）：
#   var cell = GridData.world_to_cell($layer0, global_position)
#   var floor = GridData.get_highest_floor(cell)
#
# 原理：
#   1. to_local()：把世界坐标转成 TileMapLayer 的局部坐标
#   2. local_to_map()：把局部像素坐标转成格子坐标（自动算等距斜切）
# ------------------------------------------------------------
func world_to_cell(layer_ref: TileMapLayer, world_pos: Vector2) -> Vector2i:
	var local_pos: Vector2 = layer_ref.to_local(world_pos)
	return layer_ref.local_to_map(local_pos)


# ------------------------------------------------------------
# 函数：get_floor_pixel_offset(floor) -> float
# 参数：floor —— 楼层编号（0、1、2...）
# 返回：该楼层对应的 Y 像素偏移（负值，因为高楼层Y更小）
#
# 作用：把"楼层编号"换算成"要在 Y 轴上偏移多少像素"。
#       楼层 0 → 0（不动）
#       楼层 1 → -8（上移8px）
#       楼层 2 → -16（上移16px）
#       用于角色跨层时调整真实渲染位置 / 排序基准。
# ------------------------------------------------------------
func get_floor_pixel_offset(floor: int) -> float:
	return -float(floor) * FLOOR_HEIGHT


# ------------------------------------------------------------
# 附带说明：如何把这个脚本变成 Autoload 单例
# ------------------------------------------------------------
# 1. 打开 Godot 编辑器 → 顶部菜单「项目(Project)」→「项目设置」
# 2. 切到「自动加载(Autoload)」标签页
# 3. 在「路径(Path)」填：res://script/grid_date.gd
#    在「节点名(Node Name)」填：GridData
# 4. 点「添加(Add)」按钮
#
# 完成后，游戏运行时会自动存在一个全局节点叫 GridData，
# 任何脚本里都能直接写 GridData.get_highest_floor(...) 使用。
# ============================================================